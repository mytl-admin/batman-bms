# Copy to .env.dev / .env.production (do not commit filled values)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
OPENAI_API_KEY=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
NODE_ENV=
PORT=3000
FRONTEND_ORIGIN=
# Optional: Postgres URI (Supabase → Database → URI) for: npm run db:apply
DATABASE_URL=
# Supabase Storage bucket for booking documents (must exist; uploads 503 if unset)
DOCUMENTS_STORAGE_BUCKET=
# Optional: signed URL TTL in seconds for document reads (default 3600)
DOCUMENTS_SIGNED_URL_TTL_SECONDS=
# Optional: max multipart upload size in bytes (e.g. 15728640)
UPLOAD_MAX_BYTES=
